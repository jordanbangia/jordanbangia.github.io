{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jordanbangia-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "jordanbangia.com", "custom_domain": true },
    { "pattern": "www.jordanbangia.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker runs first so it can redirect www to the apex.
    "run_worker_first": true
  },
  // Destination comes from the CONTACT_TO secret so it never lands in this repo.
  "send_email": [{ "name": "CONTACT_EMAIL" }]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jordanbangia-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Destination comes from the CONTACT_TO secret so it never lands in this repo.
  "send_email": [{ "name": "CONTACT_EMAIL" }]
}

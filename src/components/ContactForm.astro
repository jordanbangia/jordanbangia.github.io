---
// Contact form posted to the Worker at /api/contact. Sits on the accent-coloured contact section.
import { turnstileSiteKey } from '../data/profile';
---

<form class="contact" method="post" action="/api/contact">
  <div class="pair">
    <label>
      <span>Name</span>
      <input name="name" autocomplete="name" required maxlength="200" />
    </label>
    <label>
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required maxlength="320" />
    </label>
  </div>
  <label>
    <span>What are you working on?</span>
    <textarea name="message" rows="5" required maxlength="5000"></textarea>
  </label>
  <input class="hp" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
  <div class="actions">
    <button type="submit">Send message</button>
    <p class="status" role="status" aria-live="polite"></p>
  </div>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.querySelector<HTMLFormElement>('form.contact');
  const status = form?.querySelector<HTMLElement>('.status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !button) return;
    button.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        form.reset();
        status.textContent = "Thanks, your message is on its way. I'll get back to you soon.";
      } else {
        status.textContent = data.error ?? 'Something went wrong. Please try again.';
      }
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
    } finally {
      button.disabled = false;
      (window as any).turnstile?.reset();
    }
  });
</script>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-on-accent);
  }

  input,
  textarea {
    font: inherit;
    font-size: 15px;
    font-weight: 400;
    color: var(--color-ink);
    background: var(--color-panel);
    border: 1px solid color-mix(in srgb, var(--color-on-accent) 60%, var(--color-accent));
    border-radius: 16px;
    padding: 12px 16px;
    width: 100%;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-on-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-on-accent) 25%, transparent);
  }

  textarea {
    resize: vertical;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  button {
    font: inherit;
    font-weight: 600;
    background: var(--color-on-accent);
    color: #f7f6f3;
    border: 0;
    border-radius: 999px;
    padding: 14px 28px;
    cursor: pointer;
    transition: transform 200ms ease;
  }

  button:hover:not(:disabled) {
    transform: translateY(-2px);
  }

  button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .status {
    margin: 0;
    font-size: 14px;
    color: var(--color-on-accent);
  }

  @media (max-width: 560px) {
    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>

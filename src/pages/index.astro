---
import Base from '../layouts/Base.astro';
import { profile, consulting, experience, education, links, turnstileSiteKey } from '../data/profile';

const description = `${profile.name}: ${profile.headline}. Portfolio, experience and consulting.`;
---

<Base title={profile.name} description={description}>
  <main>
    <header class="intro">
      <h1>{profile.name}</h1>
      <p class="muted">{profile.headline}</p>
      <p class="muted">{profile.location}</p>
    </header>

    <section>
      <h2>About</h2>
      <div class="body">
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section id="consulting">
      <h2>Consulting</h2>
      <div class="body">
        <p>{consulting.pitch}</p>
        <ul class="services">
          {consulting.services.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    <section id="contact">
      <h2>Get in touch</h2>
      <form class="contact" method="post" action="/api/contact">
        <label>
          <span>Name</span>
          <input name="name" autocomplete="name" required maxlength="200" />
        </label>
        <label>
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required maxlength="320" />
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" rows="5" required maxlength="5000"></textarea>
        </label>
        <input class="hp" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
        <div class="actions">
          <button class="button" type="submit">Send</button>
          <p class="status muted" role="status" aria-live="polite"></p>
        </div>
      </form>
    </section>

    <section>
      <h2>Experience</h2>
      <div class="entries">
        {
          experience.map((job) =>
            job.roles.map((role, i) => (
              <div class="entry">
                <span class="date">
                  {role.start} – {role.end}
                </span>
                <div>
                  <h3>
                    {role.title} at{' '}
                    {job.url ? <a href={job.url}>{job.company}</a> : job.company}
                  </h3>
                  {role.note && <p class="muted">{role.note}</p>}
                  {i === job.roles.length - 1 && job.summary && (
                    <p class="summary">{job.summary}</p>
                  )}
                </div>
              </div>
            )),
          )
        }
      </div>
    </section>

    <section>
      <h2>Education</h2>
      <div class="entries">
        {
          education.map((e) => (
            <div class="entry">
              <span class="date">
                {e.start} – {e.end}
              </span>
              <div>
                <h3>{e.school}</h3>
                <p class="muted">{e.degree}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Links</h2>
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label} ↗</a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.querySelector<HTMLFormElement>('form.contact');
  const status = form?.querySelector<HTMLElement>('.status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !button) return;
    button.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        form.reset();
        status.textContent = "Thanks, your message is on its way. I'll get back to you soon.";
      } else {
        status.textContent = data.error ?? 'Something went wrong. Please try again.';
      }
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
    } finally {
      button.disabled = false;
      (window as any).turnstile?.reset();
    }
  });
</script>

<style>
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 96px 24px 120px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .intro h1 {
    font-size: 17px;
    font-weight: 600;
  }

  h2 {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 20px;
  }

  h3 {
    font-size: 15px;
    font-weight: 400;
  }

  .muted,
  .date {
    color: var(--muted);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .services {
    padding-left: 18px;
    color: var(--muted);
  }

  .button {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--faint);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
  }

  .button:hover {
    border-color: var(--muted);
  }

  .button {
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact label {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact label span {
    color: var(--muted);
  }

  .contact input,
  .contact textarea {
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--faint);
    border-radius: 8px;
    padding: 8px 10px;
    width: 100%;
  }

  .contact input:focus,
  .contact textarea:focus {
    outline: none;
    border-color: var(--muted);
  }

  .contact textarea {
    resize: vertical;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .entry {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
  }

  .date {
    font-variant-numeric: tabular-nums;
  }

  .summary {
    margin-top: 6px;
    color: var(--muted);
  }

  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  @media (max-width: 560px) {
    main {
      padding: 56px 16px 80px;
      gap: 44px;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
